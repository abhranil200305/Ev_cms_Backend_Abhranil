{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": [
      "node"
    ],

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "allowJs": false,

    "isolatedModules": true,

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*",
    "drizzle.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}