{
  "name": "ev-cms-backend",
  "version": "1.0.0",
  "description": "EV Charger CMS Backend using Bun, TypeScript, PostgreSQL and Drizzle ORM",
  "author": "Abhranil Pal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@latest",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc",
    "check": "tsc --noEmit",

    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun drizzle/seed.ts",

    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^11.0.0",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}